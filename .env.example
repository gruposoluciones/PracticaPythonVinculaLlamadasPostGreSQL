# Copia este archivo a .env y ajusta los valores.
# .env NUNCA debe subirse al repositorio.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=comunicaciones

# Usuario de la aplicación (recomendado crearlo con scripts/crear_usuario_app.ps1).
DB_USER=vincula
DB_PASSWORD=cambiar_esta_contrasena

# Credenciales de administración, solo para crear la base y el esquema.
# Si no se definen, los scripts las piden por consola.
# DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD=

# La API debe escuchar solo en localhost.
API_HOST=127.0.0.1
API_PORT=8000

# Límites de la aplicación.
MAX_FILAS=500
MAX_SUBIDA_MB=25
